{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Workers runtime and binding types come from `wrangler types` (worker-configuration.d.ts),
    // not from the DOM lib or Node: code here runs on workerd. Regenerate with `pnpm cf-typegen`.
    "lib": ["ES2023"],
    "types": ["./worker-configuration.d.ts"],
    "exactOptionalPropertyTypes": true
  },
  "include": ["src"]
}
