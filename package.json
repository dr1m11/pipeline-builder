{
  "name": "pipeline-builder",
  "version": "0.0.0",
  "private": true,
  "description": "Node-based editor for building and running LLM and data pipelines in the browser",
  "license": "MIT",
  "author": "Marat Gabdrashitov",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @pipeline-builder/web dev",
    "build": "pnpm --filter @pipeline-builder/web build",
    "preview": "pnpm --filter @pipeline-builder/web preview",
    "storybook": "pnpm --filter @pipeline-builder/web storybook",
    "build-storybook": "pnpm --filter @pipeline-builder/web build-storybook",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fsd": "pnpm --filter @pipeline-builder/web lint:fsd",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "vitest run --project core --project web",
    "test:watch": "vitest --project core --project web",
    "test:coverage": "vitest run --project core --project web --coverage",
    "test:storybook": "vitest run --project storybook",
    "test:e2e": "pnpm --filter @pipeline-builder/web test:e2e",
    "test:hooks": "node --test \".claude/hooks/*.test.mjs\"",
    "verify": "pnpm format:check && pnpm lint && pnpm lint:fsd && pnpm typecheck && pnpm test && pnpm test:hooks && pnpm build",
    "verify:full": "pnpm verify && pnpm test:storybook && pnpm test:e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint-react/eslint-plugin": "5.26.1",
    "@eslint/js": "10.0.1",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-storybook": "10.6.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.4"
  }
}
