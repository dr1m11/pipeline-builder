{
  "name": "pipeline-builder",
  "version": "0.0.0",
  "private": true,
  "description": "Node-based editor for building and running LLM and data pipelines in the browser",
  "license": "MIT",
  "author": "Marat Gabdrashitov",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "test:hooks": "node --test \".claude/hooks/*.test.mjs\"",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:hooks",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "catalog:",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.1"
  }
}
