{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm dev*)",
      "Bash(pnpm verify*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm preview*)",
      "Bash(pnpm format*)",
      "Bash(pnpm knip*)",
      "Bash(pnpm storybook*)",
      "Bash(pnpm build-storybook*)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec prettier *)",
      "Bash(pnpm exec steiger *)",
      "Bash(pnpm exec playwright test*)",
      "Bash(pnpm exec playwright-cli *)",
      "Bash(pnpm --filter * exec *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(git pull --ff-only*)",
      "Bash(git rev-parse*)",
      "Bash(git stash list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(npx ctx7@latest *)",
      "mcp__storybook"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git clean*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo *)",
      "Bash(gh secret *)",
      "Bash(gh api *)",
      "Bash(gh label *)",
      "Bash(gh issue create*)",
      "Bash(gh release *)",
      "Bash(pnpm add*)",
      "Bash(pnpm remove*)",
      "Bash(pnpm up*)",
      "Bash(pnpm update*)",
      "Bash(pnpm dlx*)",
      "Bash(pnpm exec wrangler *)",
      "Bash(npx wrangler *)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)",
      "Read(./**/.dev.vars*)",
      "Edit(./pnpm-lock.yaml)",
      "Write(./pnpm-lock.yaml)"
    ]
  },
  "enabledMcpjsonServers": ["storybook", "chrome-devtools"],
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git.mjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-files.mjs"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format-lint.mjs"],
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-typecheck.mjs"],
            "timeout": 180
          }
        ]
      }
    ]
  }
}
